# 目前 demo 用本機 localStorage，不必填 Firebase。
# 以後若要重新接雲端，再填 Project settings → Your apps，並改 src/lib/firebase.ts。
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optional：若 AI service 不在 127.0.0.1:8787，可改成 POST /analyze-workorder 的網址。
VITE_AI_WORKORDER_ENDPOINT=

# Optional：中文語音結果的 Codex 複核端點；預設為 http://127.0.0.1:8787/judge-speech。
VITE_AI_SPEECH_ENDPOINT=
